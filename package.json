{
  "name": "reins",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "server",
    "kit"
  ],
  "scripts": {
    "server": "tsx --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:build": "cd app && vite build --config vite.demo.config.ts && mv ../site/app/demo.html ../site/app/index.html",
    "glasses:build": "cd app && VITE_REINS_SERVER=https://reins-jhyz.onrender.com vite build --config vite.glasses.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
